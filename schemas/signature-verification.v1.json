{
  "$defs": {
    "TrustDomain": {
      "enum": [
        "community",
        "enterprise"
      ],
      "title": "TrustDomain",
      "type": "string"
    },
    "ValidationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Result produced by a Sigstore or pinned private-PKI adapter.",
  "properties": {
    "code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "identity": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity"
    },
    "manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Digest"
    },
    "oidc_issuer": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oidc Issuer"
    },
    "policy_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Digest"
    },
    "source_commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Commit Sha"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "subject_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Subject Digest",
      "type": "string"
    },
    "trust_domain": {
      "$ref": "#/$defs/TrustDomain"
    }
  },
  "required": [
    "subject_digest",
    "trust_domain",
    "status",
    "code"
  ],
  "title": "SignatureVerificationV1",
  "type": "object"
}
