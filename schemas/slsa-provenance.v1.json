{
  "$defs": {
    "ResourceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "sha256",
              "gitCommit"
            ]
          },
          "title": "Digest",
          "type": "object"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest"
      ],
      "title": "ResourceDescriptor",
      "type": "object"
    },
    "SlsaBuildDefinitionV1": {
      "additionalProperties": false,
      "properties": {
        "build_type": {
          "const": "https://skilltrust.dev/build/v1",
          "default": "https://skilltrust.dev/build/v1",
          "title": "Build Type",
          "type": "string"
        },
        "external_parameters": {
          "additionalProperties": true,
          "title": "External Parameters",
          "type": "object"
        },
        "internal_parameters": {
          "additionalProperties": true,
          "title": "Internal Parameters",
          "type": "object"
        },
        "resolved_dependencies": {
          "items": {
            "$ref": "#/$defs/ResourceDescriptor"
          },
          "title": "Resolved Dependencies",
          "type": "array"
        }
      },
      "required": [
        "external_parameters",
        "internal_parameters",
        "resolved_dependencies"
      ],
      "title": "SlsaBuildDefinitionV1",
      "type": "object"
    },
    "SlsaBuildMetadataV1": {
      "additionalProperties": false,
      "properties": {
        "finished_on": {
          "format": "date-time",
          "title": "Finished On",
          "type": "string"
        },
        "invocation_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Invocation Id",
          "type": "string"
        },
        "started_on": {
          "format": "date-time",
          "title": "Started On",
          "type": "string"
        }
      },
      "required": [
        "invocation_id",
        "started_on",
        "finished_on"
      ],
      "title": "SlsaBuildMetadataV1",
      "type": "object"
    },
    "SlsaBuilderV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SlsaBuilderV1",
      "type": "object"
    },
    "SlsaRunDetailsV1": {
      "additionalProperties": false,
      "properties": {
        "builder": {
          "$ref": "#/$defs/SlsaBuilderV1"
        },
        "metadata": {
          "$ref": "#/$defs/SlsaBuildMetadataV1"
        }
      },
      "required": [
        "builder",
        "metadata"
      ],
      "title": "SlsaRunDetailsV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Predicate accepted by `sigstore attest --predicate-type .../provenance/v1`.",
  "properties": {
    "build_definition": {
      "$ref": "#/$defs/SlsaBuildDefinitionV1"
    },
    "run_details": {
      "$ref": "#/$defs/SlsaRunDetailsV1"
    }
  },
  "required": [
    "build_definition",
    "run_details"
  ],
  "title": "SlsaProvenanceV1",
  "type": "object"
}
