{
  "$defs": {
    "TrustDomain": {
      "enum": [
        "community",
        "enterprise"
      ],
      "title": "TrustDomain",
      "type": "string"
    },
    "ValidationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Freshness result from a domain-specific TUF client and root.",
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "root_version": {
      "minimum": 1,
      "title": "Root Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "timestamp_version": {
      "minimum": 1,
      "title": "Timestamp Version",
      "type": "integer"
    },
    "trust_domain": {
      "$ref": "#/$defs/TrustDomain"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "trust_domain",
    "artifact_digest",
    "status",
    "code",
    "checked_at",
    "valid_until",
    "root_version",
    "timestamp_version"
  ],
  "title": "CatalogVerificationV1",
  "type": "object"
}
