{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "clone_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Clone Url",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "contribution_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contribution Id"
        },
        "provider": {
          "enum": [
            "github",
            "azure-devops",
            "generic-git"
          ],
          "title": "Provider",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "repository_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "repository_id",
        "clone_url",
        "commit_sha"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TrustDomain": {
      "enum": [
        "community",
        "enterprise"
      ],
      "title": "TrustDomain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "skilltrust.dev/v1",
      "default": "skilltrust.dev/v1",
      "title": "Api Version",
      "type": "string"
    },
    "approval_subjects": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Approval Subjects",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "ContributionRequest",
      "default": "ContributionRequest",
      "title": "Kind",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_by": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Requested By",
      "type": "string"
    },
    "requested_trust_domain": {
      "$ref": "#/$defs/TrustDomain"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    }
  },
  "required": [
    "request_id",
    "source",
    "manifest_digest",
    "requested_trust_domain",
    "requested_by",
    "created_at"
  ],
  "title": "ContributionRequestV1",
  "type": "object"
}
