{
  "$defs": {
    "TrustDomain": {
      "enum": [
        "community",
        "enterprise"
      ],
      "title": "TrustDomain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "skilltrust.dev/v1",
      "default": "skilltrust.dev/v1",
      "title": "Api Version",
      "type": "string"
    },
    "artifact_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Digests",
      "type": "array"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issuer": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "kind": {
      "const": "Revocation",
      "default": "Revocation",
      "title": "Kind",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "revocation_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Revocation Id",
      "type": "string"
    },
    "signature_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signature Bundle Digest",
      "type": "string"
    },
    "trust_domain": {
      "$ref": "#/$defs/TrustDomain"
    }
  },
  "required": [
    "revocation_id",
    "trust_domain",
    "artifact_digests",
    "reason_code",
    "reason",
    "effective_at",
    "issued_at",
    "issuer",
    "signature_bundle_digest"
  ],
  "title": "RevocationV1",
  "type": "object"
}
