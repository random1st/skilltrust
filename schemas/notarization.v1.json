{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "clone_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Clone Url",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "contribution_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contribution Id"
        },
        "provider": {
          "enum": [
            "github",
            "azure-devops",
            "generic-git"
          ],
          "title": "Provider",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "repository_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "repository_id",
        "clone_url",
        "commit_sha"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TrustDomain": {
      "enum": [
        "community",
        "enterprise"
      ],
      "title": "TrustDomain",
      "type": "string"
    },
    "ValidationResultV1": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "skilltrust.dev/v1",
          "default": "skilltrust.dev/v1",
          "title": "Api Version",
          "type": "string"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "const": "ValidationResult",
          "default": "ValidationResult",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "subject_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "validator": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Validator",
          "type": "string"
        },
        "validator_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "validator",
        "validator_version",
        "subject_digest",
        "status",
        "code",
        "message",
        "started_at",
        "completed_at"
      ],
      "title": "ValidationResultV1",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "skilltrust.dev/v1",
      "default": "skilltrust.dev/v1",
      "title": "Api Version",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "builder_identity": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Builder Identity",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "kind": {
      "const": "Notarization",
      "default": "Notarization",
      "title": "Kind",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "predicate_type": {
      "const": "https://skilltrust.dev/Notarization/v1",
      "default": "https://skilltrust.dev/Notarization/v1",
      "title": "Predicate Type",
      "type": "string"
    },
    "signature_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signature Bundle Digest",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "statement_type": {
      "const": "https://in-toto.io/Statement/v1",
      "default": "https://in-toto.io/Statement/v1",
      "title": "Statement Type",
      "type": "string"
    },
    "transparency_log_entry": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transparency Log Entry"
    },
    "trust_domain": {
      "$ref": "#/$defs/TrustDomain"
    },
    "validation_results": {
      "items": {
        "$ref": "#/$defs/ValidationResultV1"
      },
      "title": "Validation Results",
      "type": "array"
    }
  },
  "required": [
    "artifact_digest",
    "manifest_digest",
    "source",
    "trust_domain",
    "builder_identity",
    "validation_results",
    "signature_bundle_digest",
    "issued_at"
  ],
  "title": "NotarizationV1",
  "type": "object"
}
