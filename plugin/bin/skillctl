#!/bin/sh
# Selects the binary for this machine.
#
# Claude Code puts a plugin's bin/ on PATH, so this is what `skillctl` resolves to inside a
# session. Shipping one file per platform and choosing here keeps a single plugin installable
# everywhere, instead of a marketplace entry per operating system.
#
# Exiting 0 with a message when nothing matches is deliberate. This is called from hooks on
# the critical path of a session; failing loudly on an unsupported platform would break every
# session rather than the one thing that cannot work.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case $(uname -s) in
  Darwin) os=darwin ;;
  Linux)  os=linux ;;
  *)      os=unsupported ;;
esac

case $(uname -m) in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64)  arch=amd64 ;;
  *)             arch=unsupported ;;
esac

real="${here}/skillctl-${os}-${arch}"
if [ -x "${real}" ]; then
  exec "${real}" "$@"
fi

echo "skilltrust: no skillctl build for ${os}-${arch} in ${here}" >&2
echo "skilltrust: see https://github.com/random1st/skilltrust for a release binary" >&2
exit 0
